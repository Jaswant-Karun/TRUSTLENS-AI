frontend/.env.production.local
frontend/.env.development.local

# Sensitive configurations
.env
.env.*.local
*.pem
*.key

# Data & Large Artifacts (preserve structure, exclude heavy binaries)
data/raw/*
!data/raw/**/.gitkeep
!data/raw/README.md
data/processed/*.parquet
data/processed/*.csv
data/external/*
!data/external/.gitkeep
ml/artifacts/*.joblib
ml/artifacts/*.onnx
ml/artifacts/*.bin
ml/artifacts/*.safetensors
ml/artifacts/*.pt

# OS metadata
.DS_Store
Thumbs.db
desktop.ini
*.log

