{
  "name": "TRUSTLENS AI - Workflow 6: Daily Intelligence Report",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "w6-sched",
      "name": "Daily 08:00 UTC Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "notes": "TRUSTLENS AI n8n node: Daily 08:00 UTC Trigger (n8n-nodes-base.scheduleTrigger)"
    },
    {
      "id": "node-auth",
      "name": "Authenticate Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.TRUSTLENS_ADMIN_EMAIL, password: $env.TRUSTLENS_ADMIN_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "TRUSTLENS AI n8n node: Authenticate Admin (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w6-sum",
      "name": "Fetch Real Database Daily Summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/daily-summary",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        }
      },
      "notes": "TRUSTLENS AI n8n node: Fetch Real Database Daily Summary (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w6-log",
      "name": "Archive Daily Intelligence Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/log-execution",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_name: \"daily_intelligence_report\", trigger_event: \"daily_schedule\", status: \"success\", payload_summary: $json }) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Archive Daily Intelligence Audit (n8n-nodes-base.httpRequest)"
    }
  ],
  "connections": {
    "Daily 08:00 UTC Trigger": {
      "main": [
        [
          {
            "node": "Authenticate Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticate Admin": {
      "main": [
        [
          {
            "node": "Fetch Real Database Daily Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Real Database Daily Summary": {
      "main": [
        [
          {
            "node": "Archive Daily Intelligence Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}