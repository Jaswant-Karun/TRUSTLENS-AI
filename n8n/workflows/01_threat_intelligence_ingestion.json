{
  "name": "TRUSTLENS AI - Workflow 1: Threat Intelligence Ingestion",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "w1-sched",
      "name": "Schedule Trigger (Every 6h)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        160,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "notes": "TRUSTLENS AI n8n node: Schedule Trigger (Every 6h) (n8n-nodes-base.scheduleTrigger)"
    },
    {
      "id": "node-auth",
      "name": "Authenticate Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        380,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.TRUSTLENS_ADMIN_EMAIL, password: $env.TRUSTLENS_ADMIN_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "TRUSTLENS AI n8n node: Authenticate Admin (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w1-prep",
      "name": "Prepare Permitted Feed Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "parameters": {
        "jsCode": "const now = new Date().toISOString();\nreturn [{ json: { source_name: \"URLhaus_Threat_Feed\", feed_timestamp: now, workflow_id: $execution.id, indicators: [{ indicator_type: \"url\", indicator_value: \"http://secure-update-sbi-portal.top/login.php\", confidence: 0.96, tags: [\"phishing\", \"banking\"] }] } }];"
      },
      "notes": "TRUSTLENS AI n8n node: Prepare Permitted Feed Payload (n8n-nodes-base.code)"
    },
    {
      "id": "w1-ingest",
      "name": "Ingest & Deduplicate Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/ingest-feed",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Ingest & Deduplicate Feed (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w1-log",
      "name": "Log Execution Audit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/log-execution",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_name: \"threat_intelligence_ingestion\", trigger_event: \"schedule_6h\", status: \"success\", payload_summary: $json }) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Log Execution Audit (n8n-nodes-base.httpRequest)"
    }
  ],
  "connections": {
    "Schedule Trigger (Every 6h)": {
      "main": [
        [
          {
            "node": "Authenticate Admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticate Admin": {
      "main": [
        [
          {
            "node": "Prepare Permitted Feed Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Permitted Feed Payload": {
      "main": [
        [
          {
            "node": "Ingest & Deduplicate Feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest & Deduplicate Feed": {
      "main": [
        [
          {
            "node": "Log Execution Audit",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}