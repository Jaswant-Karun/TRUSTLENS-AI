# Python virtual environments & bytecode
.venv/
env/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
