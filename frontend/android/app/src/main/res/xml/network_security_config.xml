<?xml version="1.0" encoding="utf-8"?>
<!-- Release Network Security Config: strictly enforces HTTPS / TLS with zero cleartext HTTP -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
