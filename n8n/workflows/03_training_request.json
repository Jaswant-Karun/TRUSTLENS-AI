{
  "name": "TRUSTLENS AI - Workflow 3: Controlled Training Request",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "w3-wh",
      "name": "Admin Training Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-ml-training",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "w3-if",
      "name": "Verify Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sec-check",
              "leftValue": "={{ $json.headers[\"x-trustlens-automation-secret\"] }}",
              "rightValue": "={{ $env.TRUSTLENS_AUTOMATION_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      }
    },
    {
      "id": "node-auth",
      "name": "Authenticate Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.TRUSTLENS_ADMIN_EMAIL, password: $env.TRUSTLENS_ADMIN_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "w3-submit",
      "name": "Submit Controlled Training Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/training/jobs",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model_name: $node[\"Admin Training Webhook\"].json.body.model_name, dataset_version: $node[\"Admin Training Webhook\"].json.body.dataset_version || \"v1.2-cleaned\" }) }}"
      }
    },
    {
      "id": "w3-poll",
      "name": "Poll Training Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/training/jobs/{{ $json.job_id }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        }
      }
    },
    {
      "id": "w3-log",
      "name": "Log Training Completion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/log-execution",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_name: \"training_request\", trigger_event: \"admin_webhook\", status: $json.status, payload_summary: $json }) }}"
      }
    }
  ],
  "connections": {
    "Admin Training Webhook": {
      "main": [
        [
          {
            "node": "Verify Webhook Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Webhook Secret": {
      "main": [
        [
          {
            "node": "Authenticate Admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Authenticate Admin": {
      "main": [
        [
          {
            "node": "Submit Controlled Training Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit Controlled Training Job": {
      "main": [
        [
          {
            "node": "Poll Training Job Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Training Job Status": {
      "main": [
        [
          {
            "node": "Log Training Completion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}