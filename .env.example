# ==========================================
# TRUSTLENS AI — Environment Configuration
# ==========================================

# Application
APP_NAME=TrustLens AI
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# Security & CORS
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex
ALLOWED_ORIGINS=http://localhost:3000,https://trustlens.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/trustlens?retryWrites=true&w=majority
MONGODB_DB_NAME=trustlens_ai

# Machine Learning Runtime
ML_CPU_THREADS=8
ML_MODEL_REGISTRY=ml/artifacts
ENABLE_ONNX_INFERENCE=true

# n8n Automation & Webhooks
N8N_WEBHOOK_URL=http://localhost:5678/webhook/threat-alert
N8N_API_KEY=your-n8n-api-key-here

# Live Threat Intelligence APIs (Optional metadata lookups)
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/
OTX_API_KEY=your-alienvault-otx-api-key
