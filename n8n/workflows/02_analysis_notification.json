{
  "name": "TRUSTLENS AI - Workflow 2: Analysis Notification",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "w2-wh",
      "name": "Analysis Completed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "analysis-completed",
        "responseMode": "onReceived"
      },
      "notes": "TRUSTLENS AI n8n node: Analysis Completed Webhook (n8n-nodes-base.webhook)"
    },
    {
      "id": "w2-if",
      "name": "Verify Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sec-check",
              "leftValue": "={{ $json.headers[\"x-trustlens-automation-secret\"] }}",
              "rightValue": "={{ $env.TRUSTLENS_AUTOMATION_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "notes": "TRUSTLENS AI n8n node: Verify Webhook Secret (n8n-nodes-base.if)"
    },
    {
      "id": "node-auth",
      "name": "Authenticate Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.TRUSTLENS_ADMIN_EMAIL, password: $env.TRUSTLENS_ADMIN_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "TRUSTLENS AI n8n node: Authenticate Admin (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w2-notify",
      "name": "Validate & Dispatch Redacted Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/analysis-notification",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ analysis_id: $node[\"Analysis Completed Webhook\"].json.body.analysis_id, notification_channel: \"soc_webhook\" }) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Validate & Dispatch Redacted Alert (n8n-nodes-base.httpRequest)"
    }
  ],
  "connections": {
    "Analysis Completed Webhook": {
      "main": [
        [
          {
            "node": "Verify Webhook Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Webhook Secret": {
      "main": [
        [
          {
            "node": "Authenticate Admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Authenticate Admin": {
      "main": [
        [
          {
            "node": "Validate & Dispatch Redacted Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}