{
  "name": "TRUSTLENS AI - Workflow 2: Automated ML Training & Retraining Dispatch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-ml-training",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "node-1-webhook",
      "name": "Authorized Admin Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 300],
      "notes": "Receives authorized ML training request containing model_name, dataset_version, and auth headers."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-api-key",
              "leftValue": "={{ $json.headers['x-trustlens-automation-secret'] || $json.body.automation_secret }}",
              "rightValue": "={{ $env.TRUSTLENS_AUTOMATION_SECRET || 'Secr3t-TrustLens-AutoTr4in-2026' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-2-auth-check",
      "name": "Authenticate Request & Verify Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [400, 300],
      "notes": "Validates request signature and prevents unauthorized webhook abuse."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-model-valid",
              "leftValue": "={{ ['model1_text', 'model2_url', 'model3_tactics', 'model4_campaigns'].includes($json.body.model_name) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-3-validate-params",
      "name": "Validate Model & Dataset Versions",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 200],
      "notes": "Ensures requested model identifier and dataset versions conform to approved specifications."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL || 'http://127.0.0.1:8000' }}/api/v1/auth/login",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "={{ $env.TRUSTLENS_ADMIN_USER || 'admin@trustlens.ai' }}"
            },
            {
              "name": "password",
              "value": "={{ $env.TRUSTLENS_ADMIN_PASSWORD || 'AdminPass123!' }}"
            }
          ]
        }
      },
      "id": "node-4-login",
      "name": "Acquire Admin JWT Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 200],
      "notes": "Logs into TrustLens backend to obtain administrative JWT for dispatching training."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL || 'http://127.0.0.1:8000' }}/api/v1/training/jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Acquire Admin JWT Session').item.json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model_name\": \"{{ $('Authorized Admin Webhook Trigger').item.json.body.model_name }}\",\n  \"dataset_version\": \"{{ $('Authorized Admin Webhook Trigger').item.json.body.dataset_version || 'v1.2-cleaned' }}\",\n  \"hyperparameters\": {{ JSON.stringify($('Authorized Admin Webhook Trigger').item.json.body.hyperparameters || {}) }}\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-5-dispatch",
      "name": "Dispatch Job to Python Training Worker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, 200],
      "notes": "Enqueues asynchronous training job to dedicated Python worker and receives unique job_id."
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "node-6-wait",
      "name": "Wait Controlled Polling Interval",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1280, 200],
      "notes": "Waits before polling job status to ensure non-blocking worker execution."
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRUSTLENS_API_URL || 'http://127.0.0.1:8000' }}/api/v1/training/jobs/{{ $('Dispatch Job to Python Training Worker').item.json.job_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Acquire Admin JWT Session').item.json.access_token }}"
            }
          ]
        }
      },
      "id": "node-7-poll",
      "name": "Poll Training Job Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 200],
      "notes": "Retrieves real-time training progress, status, and candidate evaluation metrics from Python worker."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-job-complete",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-8-check-status",
      "name": "Check If Training Completed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1720, 200],
      "notes": "Checks whether training worker completed successfully or is still executing."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ADMIN_ALERT_WEBHOOK_URL || 'http://127.0.0.1:8000/api/v1/automation/log-execution' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Acquire Admin JWT Session').item.json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"automated_ml_training\",\n  \"trigger_event\": \"training_completed_dispatch\",\n  \"status\": \"success\",\n  \"payload_summary\": {\n    \"job_id\": \"{{ $json.job_id }}\",\n    \"model_name\": \"{{ $json.model_name }}\",\n    \"candidate_version\": \"{{ $json.candidate_version }}\",\n    \"metrics\": {{ JSON.stringify($json.metrics) }}\n  }\n}"
      },
      "id": "node-9-notify-success",
      "name": "Notify Administrator of Training Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, 100],
      "notes": "Dispatches training completion notification with full evaluation metrics."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ADMIN_ALERT_WEBHOOK_URL || 'http://127.0.0.1:8000/api/v1/automation/log-execution' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"automated_ml_training\",\n  \"trigger_event\": \"training_request_rejected\",\n  \"status\": \"failed\",\n  \"error_message\": \"Training request failed authentication, duplicate lock, or invalid model name.\"\n}"
      },
      "id": "node-10-reject",
      "name": "Notify Administrator on Rejection / Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 420],
      "notes": "Notifies administrator if training request is unauthorized or rejected."
    }
  ],
  "connections": {
    "Authorized Admin Webhook Trigger": {
      "main": [
        [
          {
            "node": "Authenticate Request & Verify Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Authenticate Request & Verify Secret": {
      "main": [
        [
          {
            "node": "Validate Model & Dataset Versions",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Administrator on Rejection / Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Model & Dataset Versions": {
      "main": [
        [
          {
            "node": "Acquire Admin JWT Session",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Administrator on Rejection / Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acquire Admin JWT Session": {
      "main": [
        [
          {
            "node": "Dispatch Job to Python Training Worker",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Job to Python Training Worker": {
      "main": [
        [
          {
            "node": "Wait Controlled Polling Interval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait Controlled Polling Interval": {
      "main": [
        [
          {
            "node": "Poll Training Job Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Training Job Status": {
      "main": [
        [
          {
            "node": "Check If Training Completed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check If Training Completed": {
      "main": [
        [
          {
            "node": "Notify Administrator of Training Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Administrator on Rejection / Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}

