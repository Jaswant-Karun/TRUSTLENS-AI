on or 100% accuracy, and automated outputs do not constitute legal proof of criminal origin."]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-2 gap-4"},["DIV",{"class":"p-5 rounded-xl bg-slate-900/90 border border-slate-800 space-y-2"},["H2",{"class":"text-sm font-bold text-slate-100 flex items-center gap-2"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-earth w-4 h-4 text-emerald-400"},["path",{"d":"M21.54 15H17a2 2 0 0 0-2 2v4.54"}],["path",{"d":"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17"}],["path",{"d":"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05"}],["circle",{"cx":"12","cy":"12","r":"10"}]],"Evaluated Languages"],["DIV",{"class":"flex flex-wrap gap-2"},["SPAN",{"class":"px-2.5 py-1 rounded text-xs font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"},"English"],["SPAN",{"class":"px-2.5 py-1 rounded text-xs font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"},"Hindi"],["SPAN",{"class":"px-2.5 py-1 rounded text-xs font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30"},"Hinglish"]],["P",{"class":"text-xs text-slate-400 mt-2"},"Unsupported / Unverified (0 samples):"," ",["SPAN",{"class":"text-amber-300 font-mono"},"Tamil, Bengali"]]],["DIV",{"class":"p-5 rounded-xl bg-slate-900/90 border border-slate-800 space-y-2"},["H2",{"class":"text-sm font-bold text-slate-100 flex items-center gap-2"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-lock w-4 h-4 text-cyan-400"},["rect",{"width":"18","height":"11","x":"3","y":"11","rx":"2","ry":"2"}],["path",{"d":"M7 11V7a5 5 0 0 1 10 0v4"}]],"Data Handling & User Rights"],["UL",{"class":"text-xs text-slate-300 space-y-1 list-disc pl-4"},["LI",{},"PII (phones, emails, OTPs, UPIs, PAN, Aadhaar) masked prior to persistence."],["LI",{},"90-day retention for analyses & unverified reports; 365-day security audit logs."],["LI",{},"Self-service data export (",["CODE",{},"/auth/export-data"],"), deletion (",["CODE",{},"/auth/account"],"), and consent (",["CODE",{},"/privacy/consent"],")."]]]],["DIV",{"class":"p-5 rounded-xl bg-slate-900/90 border border-slate-800 space-y-3"},["H2",{"class":"text-sm font-bold text-slate-100 flex items-center gap-2"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-cpu w-4 h-4 text-cyan-400"},["rect",{"width":"16","height":"16","x":"4","y":"4","rx":"2"}],["rect",{"width":"6","height":"6","x":"9","y":"9","rx":"1"}],["path",{"d":"M15 2v2"}],["path",{"d":"M15 20v2"}],["path",{"d":"M2 15h2"}],["path",{"d":"M2 9h2"}],["path",{"d":"M20 15h2"}],["path",{"d":"M20 9h2"}],["path",{"d":"M9 2v2"}],["path",{"d":"M9 20v2"}]],"Model Limitations & Prediction Uncertainty"],["DIV",{"class":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-slate-300"},["DIV",{"class":"p-3 rounded-lg bg-slate-950 border border-slate-800"},["DIV",{"class":"font-semibold text-slate-100"},"Model 1 — Multilingual Text (v2.1)"],["P",{"class":"text-slate-400 mt-1"},"Word+Char TF-IDF + Platt-calibrated LinearSVC. Evaluated on English, Hindi, Hinglish; Tamil/Bengali unverified."]],["DIV",{"class":"p-3 rounded-lg bg-slate-950 border border-slate-800"},["DIV",{"class":"font-semibold text-slate-100"},"Model 2 — Zero-Hop URL (v2.2)"],["P",{"class":"text-slate-400 mt-1"},"Offline XGBoost + brand/homograph/typosquatting signals. Never visits target URLs; uncalibrated tree score."]],["DIV",{"class":"p-3 rounded-lg bg-slate-950 border border-slate-800"},["DIV",{"class"