{
  "name": "TRUSTLENS AI - Workflow 5: Community Report Review",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true
  },
  "nodes": [
    {
      "id": "w5-wh",
      "name": "New Community Report Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        160,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "community-report-submitted",
        "responseMode": "onReceived"
      },
      "notes": "TRUSTLENS AI n8n node: New Community Report Webhook (n8n-nodes-base.webhook)"
    },
    {
      "id": "w5-if",
      "name": "Verify Webhook Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        380,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "sec-check",
              "leftValue": "={{ $json.headers[\"x-trustlens-automation-secret\"] }}",
              "rightValue": "={{ $env.TRUSTLENS_AUTOMATION_SECRET }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        }
      },
      "notes": "TRUSTLENS AI n8n node: Verify Webhook Secret (n8n-nodes-base.if)"
    },
    {
      "id": "node-auth",
      "name": "Authenticate Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $env.TRUSTLENS_ADMIN_EMAIL, password: $env.TRUSTLENS_ADMIN_PASSWORD }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "TRUSTLENS AI n8n node: Authenticate Admin (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w5-create",
      "name": "Create & Validate Report Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        820,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/reports",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($node[\"New Community Report Webhook\"].json.body) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Create & Validate Report Task (n8n-nodes-base.httpRequest)"
    },
    {
      "id": "w5-log",
      "name": "Store Audit History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        240
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRUSTLENS_API_URL }}/api/v1/automation/log-execution",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ \"Bearer \" + $node[\"Authenticate Admin\"].json.access_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow_name: \"community_report_review\", trigger_event: \"report_submitted\", status: \"awaiting_human_review\", payload_summary: { report_id: $json.report_id, status: $json.status } }) }}"
      },
      "notes": "TRUSTLENS AI n8n node: Store Audit History (n8n-nodes-base.httpRequest)"
    }
  ],
  "connections": {
    "New Community Report Webhook": {
      "main": [
        [
          {
            "node": "Verify Webhook Secret",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Webhook Secret": {
      "main": [
        [
          {
            "node": "Authenticate Admin",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Authenticate Admin": {
      "main": [
        [
          {
            "node": "Create & Validate Report Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create & Validate Report Task": {
      "main": [
        [
          {
            "node": "Store Audit History",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}