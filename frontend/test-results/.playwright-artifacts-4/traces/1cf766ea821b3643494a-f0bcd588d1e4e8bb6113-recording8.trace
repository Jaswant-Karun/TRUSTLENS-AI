{"type":"before","callId":"iyod@465","startTime":245129.972,"class":"Frame","method":"evaluateExpression","params":{"expression":"async () => {\n      const attemptLogin = () => fetch(\"/api/v1/auth/login\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\"\n        },\n        body: JSON.stringify({\n          email: \"admin@trustlens.ai\",\n          password: \"Admin@TrustLens2026!\"\n        })\n      });\n      let loginRes = await attemptLogin();\n      if (loginRes.status === 429) {\n        return {\n          loginStatus: 429,\n          stixStatus: 0,\n          jsonStatus: 0\n        };\n      }\n      if (!loginRes.ok) {\n        return {\n          loginStatus: loginRes.status,\n          stixStatus: 0,\n          jsonStatus: 0\n        };\n      }\n      const {\n        access_token\n      } = await loginRes.json();\n      localStorage.setItem(\"trustlens_token\", access_token);\n      const stixRes = await fetch(\"/api/v1/exports/stix?target_type=investigation&target_id=INV-2026-0011\", {\n        headers: {\n          Authorization: `Bearer ${access_token}`\n        }\n      });\n      const jsonRes = await fetch(\"/api/v1/exports/json?target_type=investigation&target_id=INV-2026-0011\", {\n        headers: {\n          Authorization: `Bearer ${access_token}`\n        }\n      });\n      return {\n        loginStatus: loginRes.status,\n        stixStatus: stixRes.status,\n        jsonStatus: jsonRes.status\n      };\n    }","isFunction":true,"arg":{"value":{"v":"undefined"},"handles":[]}}}
